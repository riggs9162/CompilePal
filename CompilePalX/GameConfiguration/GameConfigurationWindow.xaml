<controls:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:compilePalX="clr-namespace:CompilePalX" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:local="clr-namespace:CompilePalX" x:Class="CompilePalX.GameConfigurationWindow" Title="Game &amp; tools" Height="740" Width="680" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1" Icon="{StaticResource CompilePal.BrandIcon}" ShowIconOnTitleBar="False" MinWidth="560" MinHeight="480" Background="{DynamicResource CompilePal.Brushes.GridBackground}" TitleForeground="{DynamicResource MahApps.Brushes.Text}">
    <controls:MetroWindow.WindowButtonCommands>
        <controls:WindowButtonCommands LightCloseButtonStyle="{StaticResource LightButtonStyle}" LightMinButtonStyle="{StaticResource LightButtonStyle}" LightMaxButtonStyle="{StaticResource LightButtonStyle}"/>
    </controls:MetroWindow.WindowButtonCommands>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="20, 10, 20, 20" FocusManager.FocusedElement="{Binding ElementName=Name}">
                <TextBlock Text="Game profile" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=Name, Mode=TwoWay}" Tag="Name" Name="Name"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=SteamAppID, Mode=TwoWay}" Tag="App ID" ToolTip="Steam App ID. Used to determine which processes/parameters are compatible with the current game. Can be found on https://steamdb.info/apps/"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=GameFolder, Mode=TwoWay}" Tag="Game Folder" ToolTip="Path to the game folder.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\tf"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=BinFolder, Mode=TwoWay}" Tag="Bin Folder" ToolTip="Path to the bin folder that contains the command line tools.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\bin"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=GameEXE, Mode=TwoWay}" Tag="Game EXE" ToolTip="Path to game EXE.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\hl2.exe"/>
                <TextBlock Text="Standalone or stock compilers" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=VBSP, Mode=TwoWay}" Tag="VBSP" ToolTip="Path to vbsp.exe.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\bin\vbsp.exe"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=VVIS, Mode=TwoWay}" Tag="VVIS" ToolTip="Path to vvis.exe.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\bin\vvis.exe"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=VRAD, Mode=TwoWay}" Tag="VRAD" ToolTip="Path to vrad.exe.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\bin\vrad.exe"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=BSPZip, Mode=TwoWay}" Tag="BSPZip" ToolTip="Path to bspzip.exe.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\bin\bspzip.exe"/>
                <TextBlock Text="Game utilities" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=VBSPInfo, Mode=TwoWay}" Tag="VBSPInfo" ToolTip="Path to vbspinfo.exe.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\bin\vbspinfo.exe"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=VPK, Mode=TwoWay}" Tag="VPK" ToolTip="Path to vpk.exe.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\bin\vpk.exe"/>
                <TextBlock Text="Content folders" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=MapFolder, Mode=TwoWay}" Tag="Map Folder" ToolTip="Path to the folder containing BSP files.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\tf\maps"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=SDKMapFolder, Mode=TwoWay}" Tag="SDK Map Folder" ToolTip="Path to the folder containing VMF files.&#10;Ex. C:\Program Files (x86)\Steam\steamapps\common\Team Fortress 2\sourcesdk_content\mapsrc"/>
                <Button Click="SelectToolsPlusPlus_OnClick" Margin="0, 10, 0, 0">Select Tools++ folder...</Button>
                <TextBlock TextWrapping="Wrap" Margin="0, 5, 0, 0" Text="Sets VBSP, VVIS, VRAD and BSPZip together. Game folders, VBSPInfo, VPK and presets are unchanged."/>
                <Button Click="SaveButton_OnClick" Margin="0, 10, 0, 0">Save</Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</controls:MetroWindow>
