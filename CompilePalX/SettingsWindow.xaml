<controls:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" x:Class="CompilePalX.SettingsWindow" Title="Settings" Height="660" Width="640" MinHeight="500" MinWidth="540" WindowStartupLocation="CenterOwner" ShowIconOnTitleBar="False" Background="{DynamicResource CompilePal.Brushes.GridBackground}" TitleForeground="{DynamicResource MahApps.Brushes.Text}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><icons:PackIconMaterial Kind="Palette" Width="22" Height="22" Margin="0,0,12,0"/><TextBlock Text="Appearance &amp; workspace" FontSize="20" FontWeight="SemiBold"/></StackPanel>
  <TextBlock Text="Color theme" FontWeight="SemiBold"/>
  <ComboBox Name="AppearanceChoice" Margin="0,6,0,4" SelectedValuePath="Content"><ComboBoxItem Content="System"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox>
  <TextBlock Text="System follows your Windows app appearance, including changes while CompilePal++ is open." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16"/>
  <CheckBox Name="CompactChoice" Content="Use compact spacing" Margin="0,0,0,12"/>
  <CheckBox Name="RememberChoice" Content="Remember window and panel sizes" Margin="0,0,0,18"/>
  <StackPanel Orientation="Horizontal" Margin="0,6,0,16"><icons:PackIconMaterial Kind="Console" Width="22" Height="22" Margin="0,0,12,0"/><TextBlock Text="Compile output" FontSize="20" FontWeight="SemiBold"/></StackPanel>
  <DockPanel><TextBlock Text="Log text size" VerticalAlignment="Center"/><controls:NumericUpDown Name="LogSizeChoice" Minimum="10" Maximum="20" Interval="1" Width="110" HorizontalAlignment="Right"/></DockPanel>
  <CheckBox Name="FollowChoice" Content="Follow new output when scrolled to the bottom" Margin="0,14,0,12"/>
  <CheckBox Content="Play a sound when compilation ends" IsChecked="{Binding PlaySoundOnCompileCompletion, Mode=TwoWay}" Margin="0,0,0,18"/>
  <Expander Header="Advanced error information"><StackPanel Margin="0,10,0,0">
   <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding ErrorSourceURL, Mode=TwoWay}" Tag="Error source URL" Name="ErrorSourceURL"/>
   <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding ErrorCacheExpirationDays, Mode=TwoWay}" Tag="Cache duration (days)" PreviewTextInput="ErrorCacheDurationDays_PreviewTextInput"/>
  </StackPanel></Expander>
 </StackPanel></ScrollViewer>
 <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="90" Margin="0,0,10,0"/><Button Content="Save settings" Click="SaveButton_Click" MinWidth="120"/></StackPanel>
 </Grid>
</controls:MetroWindow>
